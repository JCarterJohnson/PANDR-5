# Optional Supabase configuration. Copy to .env.local before building.
# These two values are public client configuration, never administrator credentials.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# GitHub Pages deployment intentionally disables account sign-in.
# See docs/distribution.md before enabling cloud accounts on a hosted web build.
VITE_ENABLE_CLOUD_SYNC=true

